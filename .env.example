# Configure your AI provider credentials below.
# Copy this file to .env and paste your key.

# Option 1: ILMU AI / OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.ilmu.ai/v1
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=ilmu-glm-5.3

# Option 2: Anthropic / ILMU Anthropic endpoint
# ANTHROPIC_BASE_URL=https://api.ilmu.ai/anthropic
# ANTHROPIC_API_KEY=your_api_key_here
# ANTHROPIC_MODEL=ilmu-glm-5.3

# Option 3: Google Gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
